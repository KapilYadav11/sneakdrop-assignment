{
  "name": "sneakdrop-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for the limited sneaker drop: holds, waitlist, webhooks",
  "start": "node dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset",
    "load-test": "tsx scripts/loadTest.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}